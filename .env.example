NEXT_PUBLIC_USE_DEMO_DATA=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ClassFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google AI Studio free-tier API key. Keep this server-side; do not prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash# ClassFlow — מצב דemo (ברירת מחדל)
NEXT_PUBLIC_USE_DEMO_DATA=true

# OpenAI (Phase 5/6) — אופציונלי, יש fallback דמו
# OPENAI_API_KEY=sk-...

# Supabase Storage (קבצים מצורפים להגשות) — חובה כשמשתמשים בהגשת קבצים
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Phase 8) — אופציונלי
# RESEND_API_KEY=re_...
# RESEND_FROM=ClassFlow <noreply@yourdomain.com>

# Supabase — העתק ל-.env.local והרץ מיגרציות
# NEXT_PUBLIC_USE_DEMO_DATA=false
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# הפעלת Supabase:
# 1. צור פרויקט ב-https://supabase.com
# 2. העתק URL ו-anon key ל-.env.local
# 3. הרץ: npx supabase link --project-ref YOUR_REF
# 4. הרץ: npx supabase db push
#    (או העתק את supabase/migrations/*.sql ל-SQL Editor לפי סדר)
